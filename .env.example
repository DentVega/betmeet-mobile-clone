# Betmeet Mobile — environment template (safe to commit).
# Copy to .env (or .env.local) and fill with real values. Both .env and
# .env.local are gitignored. Read at build time by rspack.config.mjs and
# injected via DefinePlugin into src/config/env.ts.

# Existing Supabase project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon key (client-safe). Variable name kept as
# SUPABASE_ANON_KEY for compatibility with the app code.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WebAuthn Relying Party ID for passkeys (a domain you control that hosts
# /.well-known/assetlinks.json with the app SHA-256). Empty = passkeys disabled.
PASSKEY_RP_ID=
